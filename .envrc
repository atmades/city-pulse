# Loaded automatically by direnv when entering the project directory.
# No secrets here: personal values live in .env (ignored by git).

# Never inherit credentials from other projects: use ADC (gcloud auth application-default login).
unset GOOGLE_APPLICATION_CREDENTIALS

# Personal settings (project ID etc.), see .env.example
dotenv_if_exists .env

# Point gcloud, client libraries and Terraform at this project's dev environment.
export CLOUDSDK_CORE_PROJECT="${GCP_PROJECT_ID}"
export GOOGLE_CLOUD_PROJECT="${GCP_PROJECT_ID}"
export TF_VAR_project_id="${GCP_PROJECT_ID}"
